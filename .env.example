# Local diagnosis runner credentials (copy this file to `.env` to enable diagnosis).
#
# - `.env` is gitignored and never committed; `.env.example` is the committed template.
# - The key is read ONLY by the local runner/service process environment and never
#   enters the browser, observation bundle, logs, or diagnosis prompts.
# - Leave this empty if you only want the deterministic audit (no diagnosis).
ANTHROPIC_API_KEY=
